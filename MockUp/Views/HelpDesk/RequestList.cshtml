@model IEnumerable<RequestForm.Models.Request>

@{
    ViewData["Title"] = "My Requests";
}

@section Styles {
    <link rel="stylesheet" href="~/css/myrequests.css" />
}

<div class="container-fluid myrequests-page">

    <div class="card shadow">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h3>All Requests</h3>

        </div>

        <div class="card-body">

            <form method="get"
                  id="filterForm"
                  class="row mb-3">

                <div class="col-md-4">

                    <input class="form-control"
                           name="search"
                           value="@ViewBag.Search"
                           placeholder="Search request..." />

                </div>

                <div class="col-md-3">

                    <select class="form-select"
                            name="status"
                            onchange="document.getElementById('filterForm').submit();">

                        <option value="All">All Status</option>

                        <option value="Pending"
                                selected="@(ViewBag.Status == "Pending")">
                            Pending
                        </option>

                        <option value="Approved"
                                selected="@(ViewBag.Status == "Approved")">
                            Approved
                        </option>

                        <option value="Rejected"
                                selected="@(ViewBag.Status == "Rejected")">
                            Rejected
                        </option>

                        <option value="In Progress"
                                selected="@(ViewBag.Status == "In Progress")">
                            In Progress
                        </option>

                        <option value="Completed"
                                selected="@(ViewBag.Status == "Completed")">
                            Completed
                        </option>

                    </select>

                </div>
                                
                <div class="col-md-2">

                    <a asp-action="RequestList"
                       class="btn btn-secondary w-100">

                        Clear

                    </a>

                </div>

            </form>

            <table class="table table-hover align-middle">

                <thead>

                    <tr>

                        <th>Ref. #</th>
                        <th>Title</th>
                        <th>Request Type</th>
                        <th>Date Submitted</th>
                        <th>Status</th>
                        <th width="220">Action</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.ReferenceNumber</td>

                                <td>@item.Title</td>

                                <td>@item.RequestType?.RequestTypeName</td>

                                <td>@item.DateSubmitted.ToString("MMM dd, yyyy")</td>

                                <td>
                                    @{
                                        var badge = item.Status?.StatusName switch
                                        {
                                            "Pending" => "bg-warning text-dark",
                                            "Approved by Help Desk" => "border border-2 border-primary text-black bg-primary-subtle",
                                            "Approved by Supervisor" => "border border-2 border-success text-black bg-success-subtle",
                                            "Approved by Manager" => "bg-success",
                                            "Rejected" => "bg-danger",
                                            "In Progress" => "bg-primary",
                                            "Completed" => "bg-secondary",
                                            _ => "bg-dark"
                                        };
                                    }

                                    <span class="badge @badge">
                                        @item.Status?.StatusName
                                    </span>
                                </td>

                                <td>

                                    <a asp-controller="HelpDesk"
                                       asp-action="Review"
                                       asp-route-id="@item.RequestId"
                                       class="btn btn-info btn-sm d-inline-flex align-items-center justify-content-center">

                                        View

                                    </a>

                                    @if (item.Status?.StatusName == "Pending")
                                    {
                                        <button type="button"
                                                class="btn btn-success btn-sm d-inline-flex align-items-center justify-content-center approval-btn"
                                                data-id="@item.RequestId"
                                                data-action="Approved"
                                                data-bs-toggle="modal"
                                                data-bs-target="#approvalModal">

                                            Approve

                                        </button>

                                        <button type="button"
                                                class="btn btn-danger btn-sm d-inline-flex align-items-center justify-content-center approval-btn"
                                                data-id="@item.RequestId"
                                                data-action="Rejected"
                                                data-bs-toggle="modal"
                                                data-bs-target="#approvalModal">

                                            Reject

                                        </button>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No requests found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<partial name="_ApprovalModal" model="@("HelpDesk")" />

@section Scripts {

    <script>

        let timer;

        const form =
            document.getElementById("filterForm");

        const search =
            document.querySelector("input[name='search']");

        search.addEventListener("keyup", function () {

            clearTimeout(timer);

            timer = setTimeout(function () {

                form.submit();

            }, 500);

        });

    </script>

}
