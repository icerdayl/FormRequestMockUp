@model IEnumerable<RequestForm.Models.Request>

@{
    ViewData["Title"] = "Requests Lists";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/myrequests.css" />
}

<div class="container-fluid">

    <div class="card shadow">

        <div class="card-header">

            <h3>All Requests</h3>

        </div>

        <div class="card-body">

            <form id="filterForm"
                  class="row mb-3">

                <div class="col-md-4">

                    <input type="text"
                           id="searchInput"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Search request..." />

                </div>

                <div class="col-md-3">

                    <select id="statusFilter"
                            name="status"
                            class="form-select">

                        <option value="All">
                            All Status
                        </option>

                        <option value="Pending"
                                selected="@(ViewBag.Status == "Pending")">
                            Pending
                        </option>

                        <option value="Approved by Help Desk"
                                selected="@(ViewBag.Status == "Approved by Help Desk")">
                            Approved by Help Desk
                        </option>

                        <option value="Approved by Supervisor"
                                selected="@(ViewBag.Status == "Approved by Supervisor")">
                            Approved by Supervisor
                        </option>

                        <option value="Approved by Manager"
                                selected="@(ViewBag.Status == "Approved by Manager")">
                            Approved by Manager
                        </option>

                        <option value="Rejected"
                                selected="@(ViewBag.Status == "Rejected")">
                            Rejected
                        </option>

                        <option value="In Progress"
                                selected="@(ViewBag.Status == "In Progress")">
                            In Progress
                        </option>

                        <option value="Completed"
                                selected="@(ViewBag.Status == "Completed")">
                            Completed
                        </option>

                    </select>

                </div>

                <div class="col-md-2">

                    <button type="button"
                            id="clearFilter"
                            class="btn btn-secondary w-100">

                        Clear

                    </button>

                </div>

            </form>


            <div id="requestTableContainer">

                <partial name="_RequestListTable"
                         model="@Model" />

            </div>

        </div>

    </div>

</div>

<partial name="_ApprovalModal" model="@("HelpDesk")" />

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const searchInput =
                document.getElementById("searchInput");

            const statusFilter =
                document.getElementById("statusFilter");

            const clearFilter =
                document.getElementById("clearFilter");

            const tableContainer =
                document.getElementById("requestTableContainer");


            let searchTimer;


            async function loadRequests() {

                const search =
                    searchInput.value;

                const status =
                    statusFilter.value;


                const params =
                    new URLSearchParams();

                if (search.trim() !== "") {
                    params.append("search", search);
                }

                if (status !== "All") {
                    params.append("status", status);
                }


                tableContainer.innerHTML = `
                            <div class="text-center py-4">
                                <div class="spinner-border"
                                     role="status">

                                    <span class="visually-hidden">
                                        Loading...
                                    </span>

                                </div>
                            </div>
                        `;


                try {

                    const response =
                        await fetch(
                            `/HelpDesk/RequestList?${params.toString()}`,
                            {
                                headers: {
                                    "X-Requested-With":
                                        "XMLHttpRequest"
                                }
                            }
                        );


                    if (!response.ok) {
                        throw new Error(
                            `HTTP error ${response.status}`
                        );
                    }


                    const html =
                        await response.text();


                    tableContainer.innerHTML =
                        html;


                }
                catch (error) {

                    console.error(
                        "Failed to load requests:",
                        error
                    );

                    tableContainer.innerHTML = `
                                <div class="alert alert-danger">
                                    Failed to load requests.
                                </div>
                            `;

                }

            }


            searchInput.addEventListener(
                "input",
                function() {

                    clearTimeout(searchTimer);

                    searchTimer =
                        setTimeout(
                            loadRequests,
                            400
                        );

                }
            );


            statusFilter.addEventListener(
                "change",
                function() {

                    loadRequests();

                }
            );


            clearFilter.addEventListener(
                "click",
                function() {

                    searchInput.value = "";

                    statusFilter.value = "All";

                    loadRequests();

                }
            );

        });

    </script>

}