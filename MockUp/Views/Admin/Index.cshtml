@{
    ViewData["Title"] = "Administration";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
}

<div class="container-fluid">

    <h2 class="mb-4">
        Administration
    </h2>

    <div class="row g-4">

        <div class="col-lg-3 col-md-6">

            <div class="card admin-card">

                <div class="card-body text-center">

                    <i class="bi bi-diagram-3 display-4"></i>

                    <h5 class="mt-3">
                        Request Types
                    </h5>

                    <p class="text-muted">
                        Maintain available request categories.
                    </p>

                    <a href="#" class="btn btn-primary">
                        Open
                    </a>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card admin-card">

                <div class="card-body text-center">

                    <i class="bi bi-building display-4"></i>

                    <h5 class="mt-3">
                        Departments
                    </h5>

                    <p class="text-muted">
                        Manage company departments.
                    </p>

                    <a href="#" class="btn btn-primary">
                        Open
                    </a>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card admin-card">

                <div class="card-body text-center">

                    <i class="bi bi-flag display-4"></i>

                    <h5 class="mt-3">
                        Priorities
                    </h5>

                    <p class="text-muted">
                        Configure request priorities.
                    </p>

                    <a href="#" class="btn btn-primary">
                        Open
                    </a>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card admin-card">

                <div class="card-body text-center">

                    <i class="bi bi-people display-4"></i>

                    <h5 class="mt-3">
                        Users
                    </h5>

                    <p class="text-muted">
                        Manage user accounts and roles.
                    </p>

                    <a href="#" class="btn btn-primary">
                        Open
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>