@model RequestForm.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" />
}

<div class="container-fluid">

    <div class="mb-4">

        <h2 class="fw-bold">
            Dashboard
        </h2>

        <p class="text-muted">
            Welcome back, John Doe.
        </p>

    </div>

    <div class="row row-cols-2 row-cols-md-4 g-3 mb-4">

        <div class="col">
            <div class="stat-card-compact shadow-sm h-100 py-2 px-3 card border-0 border-start border-4 border-primary">

                <i class="bi bi-files"></i>
                <h5>Total Requests</h5>
                <h2>@Model.TotalRequests</h2>

            </div>
        </div>

        <div class="col">
            <div class="stat-card-compact shadow-sm h-100 py-2 px-3 card border-0 border-start border-4 border-warning">

                <i class="bi bi-hourglass-split"></i>
                <h5>Pending</h5>
                <h2>@Model.PendingRequests</h2>

            </div>
        </div>

        <div class="col">
            <div class="stat-card-compact shadow-sm h-100 py-2 px-3 card border-0 border-start border-4 border-success">

                <i class="bi bi-check-circle"></i>
                <h5>Approved</h5>
                <h2>@Model.ApprovedRequests</h2>

            </div>
        </div>

        <div class="col">
            <div class="stat-card-compact shadow-sm h-100 py-2 px-3 card border-0 border-start border-4 border-danger">

                <i class="bi bi-x-circle"></i>
                <h5>Rejected</h5>
                <h2>@Model.RejectedRequests</h2>

            </div>
        </div>

        <div class="col">
            <div class="stat-card-compact shadow-sm h-100 py-2 px-3 card border-0 border-start border-4 border-secondary">

                <i class="bi bi-check-circle"></i>
                <h5>In Progress</h5>
                <h2>@Model.InProgressRequests</h2>

            </div>
        </div>

        <div class="col">
            <div class="stat-card-compact shadow-sm h-100 py-2 px-3 card border-0 border-start border-4 border-dark">

                <i class="bi bi-check-circle"></i>
                <h5>Completed</h5>
                <h2>@Model.CompletedRequests</h2>

            </div>
        </div>

        <div class="col">
            <div class="stat-card-compact shadow-sm h-100 py-2 px-3 card border-0 border-start border-4 border-danger">

                <i class="bi bi-exclamation-triangle"></i>
                <h5>Overdue</h5>
                <h2>@Model.OverdueRequests</h2>

            </div>
        </div>

        <div class="col">
            <div class="stat-card-compact shadow-sm h-100 py-2 px-3 card border-0 border-start border-4 border-warning">

                <i class="bi bi-alarm"></i>
                <h5>Due Within 3 Days</h5>
                <h2>@Model.DueSoonRequests</h2>

            </div>
        </div>

    </div>
    
    @* ==============================
    HIGH PRIORITY REQUESTS
    ============================== *@

    <div class="card shadow mt-4">

        <div class="card-header">

            <h5 class="mb-0">

                High Priority Requests

            </h5>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>Reference No.</th>
                            <th>Title</th>
                            <th>Request Type</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Date Submitted</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.HighPriorityRequests.Any())
                        {
                            @foreach (var item in Model.HighPriorityRequests)
                            {
                                <tr>

                                    <td>
                                        <strong>@item.ReferenceNumber</strong>
                                    </td>

                                    <td>@item.Title</td>

                                    <td>@item.RequestType?.RequestTypeName</td>

                                    <td>
                                        @{
                                            var badge = item.Status?.StatusName switch
                                            {
                                                "Pending" => "bg-warning text-dark",
                                                "Approved by Help Desk" => "border border-2 border-primary text-black bg-primary-subtle",
                                                "Approved by Supervisor" => "border border-2 border-success text-black bg-success-subtle",
                                                "Approved by Manager" => "bg-success",
                                                "Rejected" => "bg-danger",
                                                "In Progress" => "bg-primary",
                                                "Completed" => "bg-secondary",
                                                _ => "bg-dark"
                                            };
                                        }

                                        <span class="badge @badge">
                                            @item.Status?.StatusName
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-danger">
                                            @item.Priority
                                        </span>
                                    </td>

                                    <td>
                                        @item.DateSubmitted.ToString("MMM dd, yyyy")
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6" class="text-center text-muted">

                                    No high priority requests.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    @*==============================
    DEADLINE WATCH
    ============================== *@

    <div class="card shadow mt-4">

        <div class="card-header">

            <h5 class="mb-0">Deadline Watch</h5>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>Reference No.</th>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Start Date</th>
                            <th>Due Date</th>
                            <th>Deadline</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.DeadlineWatch.Any())
                        {
                            @foreach (var item in Model.DeadlineWatch)
                            {
                                var daysLeft = (item.PreferredCompletionDate.Date - DateTime.Today).Days;

                                string deadlineClass;
                                string deadlineText;

                                if (daysLeft < 0)
                                {
                                    deadlineClass = "deadline-overdue";
                                    deadlineText = $"Overdue by {Math.Abs(daysLeft)} day(s)";
                                }
                                else if (daysLeft <= 3)
                                {
                                    deadlineClass = "deadline-due-soon";
                                    deadlineText = daysLeft == 0 ? "Due today" : $"Due in {daysLeft} day(s)";
                                }
                                else
                                {
                                    deadlineClass = "deadline-on-track";
                                    deadlineText = $"Due in {daysLeft} day(s)";
                                }

                                <tr>

                                    <td>
                                        <strong>@item.ReferenceNumber</strong>
                                    </td>

                                    <td>@item.Title</td>

                                    <td>
                                        @{
                                            var badge = item.Status?.StatusName switch
                                            {
                                                "Pending" => "bg-warning text-dark",
                                                "Approved by Help Desk" => "border border-2 border-primary text-black bg-primary-subtle",
                                                "Approved by Supervisor" => "border border-2 border-success text-black bg-success-subtle",
                                                "Approved by Manager" => "bg-success",
                                                "Rejected" => "bg-danger",
                                                "In Progress" => "bg-primary",
                                                "Completed" => "bg-secondary",
                                                _ => "bg-dark"
                                            };
                                        }

                                        <span class="badge @badge">
                                            @item.Status?.StatusName
                                        </span>
                                    </td>

                                    <td>
                                        @item.StartDate?.ToString("MMM dd, yyyy")

                                    <td>
                                        @item.PreferredCompletionDate.ToString("MMM dd, yyyy")
                                    </td>

                                    <td>
                                        <span class="deadline-badge @deadlineClass">
                                            @deadlineText
                                        </span>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="5" class="text-center text-muted">

                                    No open requests with a deadline.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    @*==============================
    RECENT REQUESTS
    ============================== *@

    <div class="card shadow mt-4">

        <div class="card-header">

            <h5 class="mb-0">Recent Requests</h5>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>Reference No.</th>
                            <th>Title</th>
                            <th>Request Type</th>
                            <th>Status</th>
                            <th>Date Submitted</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.RecentRequests.Any())
                        {
                            @foreach (var item in Model.RecentRequests)
                            {
                                <tr>

                                    <td>

                                        <strong>
                                            @item.ReferenceNumber
                                        </strong>

                                    </td>

                                    <td>@item.Title</td>

                                    <td>@item.RequestType?.RequestTypeName</td>

                                    <td>
                                        @{
                                            var badge = item.Status?.StatusName switch
                                            {
                                                "Pending" => "bg-warning text-dark",
                                                "Approved by Help Desk" => "border border-2 border-primary text-black bg-primary-subtle",
                                                "Approved by Supervisor" => "border border-2 border-success text-black bg-success-subtle",
                                                "Approved by Manager" => "bg-success",
                                                "Rejected" => "bg-danger",
                                                "In Progress" => "bg-primary",
                                                "Completed" => "bg-secondary",
                                                _ => "bg-dark"
                                            };
                                        }

                                        <span class="badge @badge">
                                            @item.Status?.StatusName
                                        </span>
                                    </td>

                                    <td>

                                        @item.DateSubmitted.ToString("MMM dd, yyyy")

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="5" class="text-center text-muted">

                                    No requests submitted yet.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    @*==============================
    TIMELINE VIEW
    ============================== *@

    <div class="card shadow mt-4">

        <div class="card-header">

            <h5 class="mb-0">Task Timeline</h5>

        </div>

        <div class="card-body">

            @if (Model.TimelineTasks.Any())
            {
                var windowStart = Model.TimelineTasks.Min(t => t.StartDate!.Value).Date.AddDays(-1);
                var windowEnd = Model.TimelineTasks.Max(t => t.PreferredCompletionDate).Date.AddDays(1);

                if (windowEnd <= windowStart)
                {
                    windowEnd = windowStart.AddDays(1);
                }

                var totalDays = (windowEnd - windowStart).TotalDays;

                var todayOffset = (DateTime.Today - windowStart).TotalDays;
                var todayPercent = Math.Min(100.0, Math.Max(0.0, todayOffset / totalDays * 100));

                <div class="timeline-wrapper">

                    <div class="timeline-scale">
                        <span style="left: 20%">@windowStart.ToString("MMM dd")</span>
                        <span style="left: 99%">@windowEnd.ToString("MMM dd")</span>
                    </div>

                    @foreach (var item in Model.TimelineTasks)
                    {
                        var start = item.StartDate!.Value.Date;
                        var end = item.PreferredCompletionDate.Date;

                        if (end < start)
                        {
                            end = start;
                        }

                        var offsetDays = (start - windowStart).TotalDays;
                        var durationDays = Math.Max(1, (end - start).TotalDays);

                        var leftPercent = Math.Min(100.0, Math.Max(0.0, offsetDays / totalDays * 100));
                        var widthPercent = Math.Min(100.0 - leftPercent, durationDays / totalDays * 100);

                        var priorityClass = item.Priority switch
                        {
                            "High" => "priority-high",
                            "Medium" => "priority-medium",
                            _ => "priority-low"
                        };

                        <div class="timeline-row">

                            <div class="timeline-label" title="@item.Title">
                                @item.ReferenceNumber &middot; @item.Title
                            </div>

                            <div class="timeline-track">

                                @if (todayPercent >= leftPercent && todayPercent <= 100)
                                {
                                    <div class="timeline-today-marker" style="left: @(todayPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                }

                                <div class="timeline-bar @priorityClass"
                                     style="left: @(leftPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; width: @(widthPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;"
                                     title="@item.StartDate?.ToString("MMM dd") - @item.PreferredCompletionDate.ToString("MMM dd")">
                                </div>

                            </div>

                        </div>
                    }

                </div>

                <div class="mt-3 d-flex gap-3 small text-muted">
                    <span><span class="badge" style="background-color:#dc3545;">&nbsp;</span> High Priority</span>
                    <span><span class="badge" style="background-color:#fd7e14;">&nbsp;</span> Medium Priority</span>
                    <span><span class="badge" style="background-color:#0d6efd;">&nbsp;</span> Low Priority</span>
                </div>
            }
            else
            {
                <p class="text-muted text-center mb-0">
                    No scheduled tasks yet. Add a Start Date to a request to see it here.
                </p>
            }

        </div>

    </div>

    @* ==============================
    STATUS CHART
    ============================== *@

    <div class="card shadow mt-4 mb-4">

        <div class="card-header">

            <h5 class="mb-0">Requests by Status</h5>

        </div>

        <div class="card-body">

            <div class="status-chart-container">
                <canvas id="statusChart"></canvas>
            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

    <script>

        const statusLabels = @Html.Raw(Json.Serialize(Model.StatusBreakdown.Keys));
        const statusData = @Html.Raw(Json.Serialize(Model.StatusBreakdown.Values));

        const statusCtx = document.getElementById("statusChart");

        if (statusCtx) {

            new Chart(statusCtx, {
                type: "bar",
                data: {
                    labels: statusLabels,   
                    datasets: [{
                        label: "Requests",
                        data: statusData,
                        backgroundColor: [
                            "#198754", "#0d6efd", "#6c757d",
                            "#ffc107", "#dc3545", "#fd7e14", "#343a40"
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { precision: 0 }
                        }
                    }
                }
            });

        }

    </script>

}
