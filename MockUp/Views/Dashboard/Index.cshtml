@model RequestForm.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/frappe-gantt@1.2.2/dist/frappe-gantt.css" />
}

<div class="container-fluid">

    <div class="mb-4">

        <h2 class="fw-bold">
            Dashboard
        </h2>

        <p class="text-muted">
            Welcome back, Ahiezer Dayl.
        </p>

    </div>

    <div class="row row-cols-2 row-cols-md-4 g-3 mb-4">

        <div class="col">
            <div class="stat-card-compact shadow-sm h-100 py-2 px-3 card border-0 border-start border-4 border-primary">

                <i class="bi bi-files"></i>
                <h5>Total Requests</h5>
                <h2>@Model.TotalRequests</h2>

            </div>
        </div>

        <div class="col">
            <div class="stat-card-compact shadow-sm h-100 py-2 px-3 card border-0 border-start border-4 border-warning">

                <i class="bi bi-hourglass-split"></i>
                <h5>Pending</h5>
                <h2>@Model.PendingRequests</h2>

            </div>
        </div>

        <div class="col">
            <div class="stat-card-compact shadow-sm h-100 py-2 px-3 card border-0 border-start border-4 border-success">

                <i class="bi bi-check-circle"></i>
                <h5>Approved (Final)</h5>
                <h2>@Model.ApprovedRequests</h2>

            </div>
        </div>

        <div class="col">
            <div class="stat-card-compact shadow-sm h-100 py-2 px-3 card border-0 border-start border-4 border-danger">

                <i class="bi bi-x-circle"></i>
                <h5>Rejected</h5>
                <h2>@Model.RejectedRequests</h2>

            </div>
        </div>

        <div class="col">
            <div class="stat-card-compact shadow-sm h-100 py-2 px-3 card border-0 border-start border-4 border-secondary">

                <i class="bi bi-check-circle"></i>
                <h5>In Progress</h5>
                <h2>@Model.InProgressRequests</h2>

            </div>
        </div>

        <div class="col">
            <div class="stat-card-compact shadow-sm h-100 py-2 px-3 card border-0 border-start border-4 border-dark">

                <i class="bi bi-check-circle"></i>
                <h5>Completed</h5>
                <h2>@Model.CompletedRequests</h2>

            </div>
        </div>

        <div class="col">
            <div class="stat-card-compact shadow-sm h-100 py-2 px-3 card border-0 border-start border-4 border-danger">

                <i class="bi bi-exclamation-triangle"></i>
                <h5>Overdue</h5>
                <h2>@Model.OverdueRequests</h2>

            </div>
        </div>

        <div class="col">
            <div class="stat-card-compact shadow-sm h-100 py-2 px-3 card border-0 border-start border-4 border-warning">

                <i class="bi bi-alarm"></i>
                <h5>Due Within 3 Days</h5>
                <h2>@Model.DueSoonRequests</h2>

            </div>
        </div>

    </div>

    @* ==============================
    HIGH PRIORITY REQUESTS
    ============================== *@

    <div class="card shadow mt-4">

        <div class="card-header">

            <h5 class="mb-0">

                High Priority Requests

            </h5>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>Reference No.</th>
                            <th>Title</th>
                            <th>Ticket Type</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Date Submitted</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.HighPriorityRequests.Any())
                        {
                            @foreach (var item in Model.HighPriorityRequests)
                            {
                                <tr>

                                    <td>
                                        <strong>@item.ReferenceNumber</strong>
                                    </td>

                                    <td>@item.Title</td>

                                    <td>@item.TicketType?.TicketTypeName</td>

                                    <td>
                                        @{
                                            var badge = item.Status?.StatusName switch
                                            {
                                                "Pending" => "bg-warning text-dark",
                                                "Approved by Help Desk" => "border border-2 border-primary text-black bg-primary-subtle",
                                                "Approved by Supervisor" => "border border-2 border-success text-black bg-success-subtle",
                                                "Approved by Manager" => "bg-success",
                                                "Rejected" => "bg-danger",
                                                "In Progress" => "bg-primary",
                                                "Completed" => "bg-secondary",
                                                _ => "bg-dark"
                                            };
                                        }

                                        <span class="badge @badge">
                                            @item.Status?.StatusName
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-danger">
                                            @item.Priority
                                        </span>
                                    </td>

                                    <td>
                                        @item.DateSubmitted.ToString("MMM dd, yyyy")
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6" class="text-center text-muted">

                                    No high priority requests.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    @*==============================
    DEADLINE WATCH
    ============================== *@

    <div class="card shadow mt-4">

        <div class="card-header">

            <h5 class="mb-0">Deadline Watch</h5>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>Reference No.</th>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Start Date</th>
                            <th>Due Date</th>
                            <th>Deadline</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.DeadlineWatch.Any())
                        {
                            @foreach (var item in Model.DeadlineWatch)
                            {
                                var daysLeft = (item.PreferredCompletionDate.Date - DateTime.Today).Days;

                                string deadlineClass;
                                string deadlineText;

                                if (daysLeft < 0)
                                {
                                    deadlineClass = "deadline-overdue";
                                    deadlineText = $"Overdue by {Math.Abs(daysLeft)} day(s)";
                                }
                                else if (daysLeft <= 3)
                                {
                                    deadlineClass = "deadline-due-soon";
                                    deadlineText = daysLeft == 0 ? "Due today" : $"Due in {daysLeft} day(s)";
                                }
                                else
                                {
                                    deadlineClass = "deadline-on-track";
                                    deadlineText = $"Due in {daysLeft} day(s)";
                                }

                                <tr>

                                    <td>
                                        <strong>@item.ReferenceNumber</strong>
                                    </td>

                                    <td>@item.Title</td>

                                    <td>
                                        @{
                                            var badge = item.Status?.StatusName switch
                                            {
                                                "Pending" => "bg-warning text-dark",
                                                "Approved by Help Desk" => "border border-2 border-primary text-black bg-primary-subtle",
                                                "Approved by Supervisor" => "border border-2 border-success text-black bg-success-subtle",
                                                "Approved by Manager" => "bg-success",
                                                "Rejected" => "bg-danger",
                                                "In Progress" => "bg-primary",
                                                "Completed" => "bg-secondary",
                                                _ => "bg-dark"
                                            };
                                        }

                                        <span class="badge @badge">
                                            @item.Status?.StatusName
                                        </span>
                                    </td>

                                    <td>
                                        @item.StartDate?.ToString("MMM dd, yyyy")

                                        <td>
                                            @item.PreferredCompletionDate.ToString("MMM dd, yyyy")
                                        </td>

                                        <td>
                                            <span class="deadline-badge @deadlineClass">
                                                @deadlineText
                                            </span>
                                        </td>

                                    </tr>
                                }
                            }
                        else
                            {
                                <tr>

                                    <td colspan="5" class="text-center text-muted">

                                        No open requests with a deadline.

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    @*==============================
    RECENT REQUESTS
    ============================== *@

        <div class="card shadow mt-4">

            <div class="card-header">

                <h5 class="mb-0">Recent Requests</h5>

            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>Reference No.</th>
                                <th>Title</th>
                                <th>Ticket Type</th>
                                <th>Status</th>
                                <th>Date Submitted</th>

                            </tr>

                        </thead>

                        <tbody>

                            @if (Model.RecentRequests.Any())
                            {
                                @foreach (var item in Model.RecentRequests)
                                {
                                    <tr>

                                        <td>

                                            <strong>
                                                @item.ReferenceNumber
                                            </strong>

                                        </td>

                                        <td>@item.Title</td>

                                        <td>@item.TicketType?.TicketTypeName</td>

                                        <td>
                                            @{
                                                var badge = item.Status?.StatusName switch
                                                {
                                                    "Pending" => "bg-warning text-dark",
                                                    "Approved by Help Desk" => "border border-2 border-primary text-black bg-primary-subtle",
                                                    "Approved by Supervisor" => "border border-2 border-success text-black bg-success-subtle",
                                                    "Approved by Manager" => "bg-success",
                                                    "Rejected" => "bg-danger",
                                                    "In Progress" => "bg-primary",
                                                    "Completed" => "bg-secondary",
                                                    _ => "bg-dark"
                                                };
                                            }

                                            <span class="badge @badge">
                                                @item.Status?.StatusName
                                            </span>
                                        </td>

                                        <td>

                                            @item.DateSubmitted.ToString("MMM dd, yyyy")

                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>

                                    <td colspan="5" class="text-center text-muted">

                                        No requests submitted yet.

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    @*==============================
    GANTT CHART (grouped by developer)
    ============================== *@

        <div class="card shadow mt-4">

            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">

                <h5 class="mb-0">Gantt Chart — by Developer & Subtask</h5>

                @if (Model.GanttByDeveloper.Any())
                {
                    <div class="btn-group btn-group-sm" role="group" aria-label="Gantt view mode">

                        <button type="button" class="btn btn-outline-secondary gantt-view-btn" data-mode="Day">Day</button>
                        <button type="button" class="btn btn-outline-secondary gantt-view-btn active" data-mode="Week">Week</button>
                        <button type="button" class="btn btn-outline-secondary gantt-view-btn" data-mode="Month">Month</button>

                    </div>
                }

            </div>

            <div class="card-body">

                @if (Model.GanttByDeveloper.Any())
                {
                    var groupIndex = 0;

                    <div class="mt-1 mb-3 d-flex gap-3 small text-muted">
                        <span><span class="badge" style="background-color:#dc3545;">&nbsp;</span> High Priority</span>
                        <span><span class="badge" style="background-color:#fd7e14;">&nbsp;</span> Medium Priority</span>
                        <span><span class="badge" style="background-color:#0d6efd;">&nbsp;</span> Low Priority</span>
                    </div>

                    foreach (var group in Model.GanttByDeveloper)
                    {
                        var containerId = $"gantt-dev-{groupIndex}";

                        <div class="gantt-group mb-4">

                            <h6 class="d-flex align-items-center gap-2">
                                <i class="bi bi-person-circle"></i>
                                @group.Key
                                <span class="badge bg-secondary">@group.Value.Count</span>
                            </h6>

                            <div id="@containerId" class="gantt-target"></div>

                        </div>

                        groupIndex++;
                    }
                }
                else
                {
                    <p class="text-muted text-center mb-0">
                        No scheduled tasks yet. Add a Start Date to a request to see it here.
                    </p>
                }

            </div>

        </div>


    @* ==============================
    STATUS CHART
    ============================== *@

        <div class="card shadow mt-4 mb-4">

            <div class="card-header">

                <h5 class="mb-0">Requests by Status</h5>

            </div>

            <div class="card-body">

                <div class="status-chart-container">
                    <canvas id="statusChart"></canvas>
                </div>

            </div>

        </div>

    </div>

    @section Scripts {

        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/frappe-gantt@1.2.2/dist/frappe-gantt.umd.js"></script>

        <script>

            (function() {

                const ganttData = @Html.Raw(Json.Serialize(
                    Model.GanttByDeveloper.Select((g, groupIndex) => new
                    {
                        containerId = "gantt-dev-" + groupIndex,
                        tasks = g.Value.Select((b, barIndex) => new
                        {
                            id = "bar-" + groupIndex + "-" + barIndex,
                            name = b.ReferenceNumber + " - " +
                                (b.SubTaskTitle != null
                                    ? b.FeatureTitle + ": " + b.SubTaskTitle
                                    : b.RequestTitle) +
                                (b.ManDays.HasValue ? " (" + b.ManDays.Value.ToString("0.##") + " MD)" : ""),
                            start = b.Start.ToString("yyyy-MM-dd"),
                            end = (b.End < b.Start ? b.Start : b.End).ToString("yyyy-MM-dd"),
                            progress = b.Status == "Completed" || b.Status == "Done" ? 100 :
                                 b.Status == "In Progress" ? 50 : 0,
                            custom_class = b.Priority == "High" ? "gantt-priority-high" :
                                 b.Priority == "Medium" ? "gantt-priority-medium" :
                                                                                            "gantt-priority-low"
                        })
                    })
                ));

                const instances = [];

                ganttData.forEach(function(group) {

                    const target = document.getElementById(group.containerId);

                    if (!target || group.tasks.length === 0) {
                        return;
                    }

                    const gantt = new Gantt(target, group.tasks, {
                        view_mode: "Week",
                        readonly: true,
                        readonly_dates: true,
                        readonly_progress: true,
                        language: "en"
                    });

                    instances.push(gantt);

                });

                const viewButtons = document.querySelectorAll(".gantt-view-btn");

                viewButtons.forEach(function(button) {

                    button.addEventListener("click", function() {

                        const mode = this.dataset.mode;

                        instances.forEach(function(gantt) {
                            gantt.change_view_mode(mode);
                        });

                        viewButtons.forEach(function(btn) {
                            btn.classList.remove("active");
                        });

                        this.classList.add("active");

                    });

                });

                document.querySelectorAll(".gantt-target").forEach(function(target) {

                    target.addEventListener("wheel", function(e) {

                        if (target.scrollWidth <= target.clientWidth) {
                            return; 
                        }

                        e.preventDefault();
                        target.scrollLeft += e.deltaY;

                    }, { passive: false });

                });

            })();

        </script>

        <script>

            const statusLabels = @Html.Raw(Json.Serialize(Model.StatusBreakdown.Keys));
            const statusData = @Html.Raw(Json.Serialize(Model.StatusBreakdown.Values));

            const statusCtx = document.getElementById("statusChart");

            if (statusCtx) {

                new Chart(statusCtx, {
                    type: "bar",
                    data: {
                        labels: statusLabels,
                        datasets: [{
                            label: "Requests",
                            data: statusData,
                            backgroundColor: [
                                "#198754", "#0d6efd", "#6c757d",
                                "#ffc107", "#dc3545", "#fd7e14", "#343a40"
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { precision: 0 }
                            }
                        }
                    }
                });

            }

        </script>

    }
