@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <div class="mb-4">

        <h2 class="fw-bold">
            Dashboard
        </h2>

        <p class="text-muted">
            Welcome back, John Doe.
        </p>

    </div>

    <div class="row g-4 gap-4 justify-content-center">

        <div class="shadow-sm col-lg-2 p-3 card border-0 border-start border-4 border-primary">

            <div class="stat-card total">

                <i class="bi bi-files"></i>
                <h5>Total Requests</h5>
                <h2>25</h2>

            </div>

        </div>

        <div class="shadow-sm col-lg-2 p-3 card border-0 border-start border-4 border-warning">

            <div class="stat-card pending">

                <i class="bi bi-hourglass-split"></i>
                <h5>Pending</h5>
                <h2>10</h2>

            </div>

        </div>

        <div class="shadow-sm col-lg-2 p-3 card border-0 border-start border-4 border-success">

            <div class="stat-card approved">

                <i class="bi bi-check-circle"></i>
                <h5>Approved</h5>
                <h2>12</h2>

            </div>

        </div>

        <div class="card shadow-sm col-lg-2 p-3 card border-0 border-start border-4 border-danger">

            <div class="stat-card rejected">

                <i class="bi bi-x-circle"></i>
                <h5>Rejected</h5>
                <h2>3</h2>

            </div>

        </div>

    </div>

    <div class="card mt-5 shadow-sm">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                Recent Website Requests
            </h5>

        </div>

        <div class="card-body">

            <table class="table table-hover">

                <thead>

                    <tr>

                        <th>ID</th>
                        <th>Title</th>
                        <th>Request Type</th>
                        <th>Status</th>
                        <th>Date</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>101</td>

                        <td>Company Website</td>

                        <td>New Website</td>

                        <td>
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        </td>

                        <td>July 30, 2026</td>

                    </tr>

                    <tr>

                        <td>102</td>

                        <td>HR Portal</td>

                        <td>Enhancement</td>

                        <td>
                            <span class="badge bg-success">
                                Approved
                            </span>
                        </td>

                        <td>July 29, 2026</td>

                    </tr>

                    <tr>

                        <td>103</td>

                        <td>Payroll System</td>

                        <td>Bug Fix</td>

                        <td>
                            <span class="badge bg-danger">
                                Rejected
                            </span>
                        </td>

                        <td>July 28, 2026</td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>