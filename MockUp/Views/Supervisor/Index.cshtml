@model IEnumerable<RequestForm.Models.Request>

@{
    ViewData["Title"] = "Supervisor Approvals";
}

<div class="card shadow">

    <div class="card-header">
        <h3>Supervisor Approvals</h3>
    </div>

    <div class="card-body">

        <table class="table table-hover align-middle">

            <thead>
                <tr>
                    <th>Ref. #</th>
                    <th>Title</th>
                    <th>Ticket Type</th>
                    <th>Date Submitted</th>
                    <th>Status</th>
                    <th>Features</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.ReferenceNumber
                            </td>

                            <td>
                                @item.Title
                            </td>

                            <td>
                                @item.TicketType?.TicketTypeName
                            </td>

                            <td>
                                @item.DateSubmitted.ToString("MMM dd, yyyy")
                            </td>

                            <td>
                                @{
                                    var badge = item.Status?.StatusName switch
                                    {
                                        "Pending" => "bg-warning text-dark",
                                        "Approved by Help Desk" => "border border-2 border-primary text-black bg-primary-subtle",
                                        "Approved by Supervisor" => "border border-2 border-success text-black bg-success-subtle",
                                        "Approved by Manager" => "bg-success",
                                        "Rejected" => "bg-danger",
                                        "In Progress" => "bg-primary",
                                        "Completed" => "bg-secondary",
                                        _ => "bg-dark"
                                    };
                                }

                                <span class="badge @badge">
                                    @item.Status?.StatusName
                                </span>
                            </td>

                            <td>
                                @{
                                    var subTaskCount = item.Features.SelectMany(f => f.SubTasks).Count();
                                }
                                @if (item.Features.Any())
                                {
                                    <span class="badge bg-light text-dark border">
                                        @item.Features.Count feature(s), @subTaskCount subtask(s)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">None added</span>
                                }
                            </td>

                            <td>

                                <div class="d-flex gap-2">

                                    <!-- REVIEW: full detail page, shows Features & Subtasks
                                         before deciding -->

                                    <a asp-action="Review"
                                       asp-route-id="@item.RequestId"
                                       class="btn btn-info btn-sm">

                                        Review

                                    </a>

                                    <!-- Quick approve/reject, same as Review's decision but
                                         without leaving the list -->

                                    <button type="button"
                                            class="btn btn-success btn-sm approval-btn"
                                            data-id="@item.RequestId"
                                            data-action="Approved"
                                            data-bs-toggle="modal"
                                            data-bs-target="#approvalModal">

                                        Approve

                                    </button>

                                    <button type="button"
                                            class="btn btn-danger btn-sm approval-btn"
                                            data-id="@item.RequestId"
                                            data-action="Rejected"
                                            data-bs-toggle="modal"
                                            data-bs-target="#approvalModal">

                                        Reject

                                    </button>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="7"
                            class="text-center text-muted py-4">

                            No requests awaiting approval.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<partial name="_ApprovalModal" model="@("Supervisor")" />



