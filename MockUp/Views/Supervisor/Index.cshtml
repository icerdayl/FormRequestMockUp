@model IEnumerable<RequestForm.Models.Request>

@{
    ViewData["Title"] = "Supervisor Approvals";
}

<div class="card shadow">

    <div class="card-header">
        <h3>Supervisor Approvals</h3>
    </div>

    <div class="card-body">

        <table class="table table-hover align-middle">

            <thead>
                <tr>
                    <th>Ref. #</th>
                    <th>Title</th>
                    <th>Request Type</th>
                    <th>Date Submitted</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.ReferenceNumber
                            </td>

                            <td>
                                @item.Title
                            </td>

                            <td>
                                @item.RequestType?.RequestTypeName
                            </td>

                            <td>
                                @item.DateSubmitted.ToString("MMM dd, yyyy")
                            </td>

                            <td>

                                @{
                                    var badge = item.Status?.StatusName switch
                                    {
                                        "Approved by Help Desk" => "bg-success",
                                        "Approved by Supervisor" => "bg-success",
                                        "Approved by Manager" => "bg-success",
                                        "Rejected" => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }

                                <span class="badge @badge">
                                    @item.Status?.StatusName
                                </span>

                            </td>

                            <td>

                                <div class="d-flex gap-2">

                                    <!-- VIEW -->

                                    <a asp-action="Review"
                                       asp-route-id="@item.RequestId"
                                       class="btn btn-info btn-sm">

                                        View

                                    </a>


                                    <!-- APPROVE -->

                                    <button type="button"
                                            class="btn btn-success btn-sm approval-btn"
                                            data-id="@item.RequestId"
                                            data-action="Approved"
                                            data-bs-toggle="modal"
                                            data-bs-target="#approvalModal">

                                        Approve

                                    </button>


                                    <!-- REJECT -->

                                    <button type="button"
                                            class="btn btn-danger btn-sm approval-btn"
                                            data-id="@item.RequestId"
                                            data-action="Rejected"
                                            data-bs-toggle="modal"
                                            data-bs-target="#approvalModal">

                                        Reject

                                    </button>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="6"
                            class="text-center text-muted py-4">

                            No requests awaiting approval.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


<!-- APPROVAL MODAL -->

<div class="modal fade"
     id="approvalModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <form asp-controller="Supervisor"
                  asp-action="UpdateStatus"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h5 class="modal-title">
                        Confirm Action
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <p id="approvalMessage">
                        Are you sure you want to perform this action?
                    </p>


                    <div class="mb-3">

                        <label class="form-label">
                            Remarks
                        </label>

                        <textarea class="form-control"
                                  id="approvalRemarks"
                                  name="remarks"
                                  rows="4"
                                  placeholder="Enter remarks..."></textarea>

                    </div>


                    <input type="hidden"
                           id="approvalRequestId"
                           name="RequestId" />

                    <input type="hidden"
                           id="approvalDecision"
                           name="decision" />

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary"
                            id="approvalConfirmButton">

                        Confirm

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        document
            .querySelectorAll(".approval-btn")
            .forEach(button => {

                button.addEventListener("click", function () {

                    const requestId =
                        this.dataset.id;

                    const action =
                        this.dataset.action;

                    document.getElementById(
                        "approvalRequestId"
                    ).value = requestId;


                    document.getElementById(
                        "approvalDecision"
                    ).value = action;


                    document.getElementById(
                        "approvalMessage"
                    ).innerText =
                        "Are you sure you want to " +
                        action.toLowerCase() +
                        " this request?";


                    const confirmButton =
                        document.getElementById(
                            "approvalConfirmButton"
                        );


                    if (action === "Approved") {

                        confirmButton.className =
                            "btn btn-success";

                        confirmButton.innerText =
                            "Approve";

                    }
                    else {

                        confirmButton.className =
                            "btn btn-danger";

                        confirmButton.innerText =
                            "Reject";

                    }

                });

            });

    </script>

}