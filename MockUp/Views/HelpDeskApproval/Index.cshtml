@model IEnumerable<RequestForm.Models.Request>

@{
    ViewData["Title"] = "Help Desk Approval";
}

<div class="container-fluid">

    <div class="card shadow">

        <div class="card-header d-flex justify-content-between">

            <h3>Help Desk Approval List</h3>

            <span class="badge bg-primary">
                @Model.Count() Request(s)
            </span>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>Reference No.</th>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th width="150">Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.ReferenceNumber</td>

                                <td>@item.Title</td>

                                <td>@item.RequestType?.RequestTypeName</td>

                                <td>

                                    <span class="badge bg-danger">
                                        @item.Priority
                                    </span>

                                </td>

                                <td>

                                    @item.Status?.StatusName

                                </td>

                                <td>

                                    <a asp-action="Review"
                                       asp-route-id="@item.RequestId"
                                       class="btn btn-primary btn-sm">

                                        Review

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>