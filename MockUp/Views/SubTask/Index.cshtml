@model List<RequestForm.Models.SubTask>
@{
    ViewData["Title"] = "Subtasks";
    var feature = ViewBag.Feature as RequestForm.Models.Feature;
    var requestStartDate = feature?.Request?.StartDate?.Date;
    var effectiveMinDate = requestStartDate.HasValue && requestStartDate.Value > DateTime.Today
        ? requestStartDate.Value
        : DateTime.Today;
    var subtaskMinDate = effectiveMinDate.ToString("yyyy-MM-dd");
    var requestDueDate = feature?.Request?.PreferredCompletionDate.ToString("yyyy-MM-dd");
    var doneCount = Model.Count(s => s.Status == "Done");
    var totalCount = Model.Count;
    var percent = totalCount == 0 ? 0 : (int)Math.Round(100.0 * doneCount / totalCount);
}

<div class="container-fluid">

    <div class="card shadow">

        <div class="card-header d-flex justify-content-between align-items-center">

            <div>
                <h3 class="mb-0">Subtasks</h3>
                <small class="text-muted">
                    @feature?.Request?.ReferenceNumber &middot; @feature?.Title
                </small>
            </div>

            <a asp-controller="Feature"
               asp-action="Index"
               asp-route-requestId="@feature?.RequestId"
               class="btn btn-secondary">

                Back to Features

            </a>

        </div>

        <div class="card-body">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            @if (totalCount > 0)
            {
                <div class="d-flex align-items-center gap-2 mb-4" style="max-width: 400px;">

                    <div class="progress flex-grow-1" style="height: 10px;">
                        <div class="progress-bar bg-success"
                             style="width: @(percent)%;"></div>
                    </div>

                    <small class="text-muted text-nowrap">
                        @doneCount / @totalCount done (@percent%)
                    </small>

                </div>
            }

            @* ===========================
               CHECKLIST
               =========================== *@

            @if (Model.Any())
            {
                <div class="table-responsive mb-4">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th style="width: 40px;"></th>
                                <th>Subtask</th>
                                <th>Start Date</th>
                                <th>Due Date</th>
                                <th>Man-Days</th>
                                <th style="width: 60px;"></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var subTask in Model)
                            {
                                var isDone = subTask.Status == "Done";
                                var editRowId = $"edit-subtask-{subTask.SubTaskId}";

                                <tr class="@(isDone ? "table-light" : "")">

                                    <td>

                                        <form asp-action="ToggleDone" method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="id" value="@subTask.SubTaskId" />
                                            <input type="hidden" name="featureId" value="@feature?.FeatureId" />

                                            <button type="submit"
                                                    class="btn btn-sm p-0 border-0 bg-transparent"
                                                    title="@(isDone ? "Mark as not done" : "Mark as done")">

                                                <i class="bi @(isDone ? "bi-check-square-fill text-success" : "bi-square") fs-5"></i>

                                            </button>

                                        </form>

                                    </td>

                                    <td class="@(isDone ? "text-decoration-line-through text-muted" : "")">
                                        @subTask.Title
                                    </td>

                                    <td>
                                        @(subTask.StartDate?.ToString("MMM dd, yyyy") ?? "—")
                                    </td>

                                    <td>
                                        @(subTask.DueDate?.ToString("MMM dd, yyyy") ?? "—")
                                    </td>

                                    <td>
                                        @(subTask.EstimatedManDays?.ToString("0.##") ?? "—")
                                    </td>

                                    <td class="text-nowrap">

                                        <button type="button"
                                                class="btn btn-outline-secondary btn-sm"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@editRowId"
                                                title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </button>

                                        <form asp-action="Delete"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Delete this subtask?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="id" value="@subTask.SubTaskId" />
                                            <input type="hidden" name="featureId" value="@feature?.FeatureId" />

                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>

                                        </form>

                                    </td>

                                </tr>

                                <tr class="collapse" id="@editRowId">

                                    <td colspan="6" class="bg-light">

                                        <form asp-action="Edit" method="post" class="row g-2 align-items-end py-2">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="id" value="@subTask.SubTaskId" />
                                            <input type="hidden" name="featureId" value="@feature?.FeatureId" />

                                            <div class="col-md-3">
                                                <label class="form-label small">Title</label>
                                                <input type="text" name="title" class="form-control form-control-sm"
                                                       value="@subTask.Title" required />
                                            </div>

                                            <div class="col-md-2">
                                                <label class="form-label small">Start Date</label>
                                                <input type="date" name="startDate" class="form-control form-control-sm auto-mandays-start"
                                                       min="@subtaskMinDate"
                                                       max="@requestDueDate"
                                                       value="@subTask.StartDate?.ToString("yyyy-MM-dd")" />
                                            </div>

                                            <div class="col-md-2">
                                                <label class="form-label small">Due Date</label>
                                                <input type="date" name="dueDate" class="form-control form-control-sm auto-mandays-due"
                                                       min="@subtaskMinDate"
                                                       max="@requestDueDate"
                                                       value="@subTask.DueDate?.ToString("yyyy-MM-dd")" />
                                            </div>

                                            <div class="col-md-2">
                                                <label class="form-label small">Man-Days (Auto)</label>
                                                <input type="text" name="estimatedManDays" class="form-control form-control-sm auto-mandays-target"
                                                       value="@(subTask.EstimatedManDays?.ToString("0.##") ?? "")" readonly />
                                            </div>

                                            <div class="col-md-1">
                                                <button type="submit" class="btn btn-primary btn-sm w-100">
                                                    Save
                                                </button>
                                            </div>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <p class="text-muted">
                    No subtasks yet. Add one below.
                </p>
            }

            <hr />

            @* ===========================
               ADD SUBTASK
               =========================== *@

            <h5>Add Subtask</h5>

            <form asp-action="Create" method="post" class="row g-3 align-items-end">

                @Html.AntiForgeryToken()

                <input type="hidden" name="FeatureId" value="@feature?.FeatureId" />

                <div class="col-md-3">
                    <label class="form-label">
                        Title <span class="required">*</span>
                    </label>
                    <input type="text" name="Title" class="form-control" required />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Start Date</label>
                    <input type="date" name="StartDate" class="form-control auto-mandays-start"
                           min="@subtaskMinDate"
                           max="@requestDueDate" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Due Date</label>
                    <input type="date" name="DueDate" class="form-control auto-mandays-due"
                           min="@subtaskMinDate"
                           max="@requestDueDate" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Man-Days (Auto)</label>
                    <input type="text" name="EstimatedManDays" class="form-control auto-mandays-target" readonly />
                </div>

                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary w-100">
                        Add
                    </button>
                </div>

                <div class="col-12">
                    <label class="form-label">Description (optional)</label>
                    <textarea name="Description" class="form-control" rows="2"></textarea>
                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        // Man-days are calculated automatically from each form's
        // Start Date and Due Date. The user cannot type or increment them.
        document.querySelectorAll(".auto-mandays-start, .auto-mandays-due").forEach(function (input) {

            input.addEventListener("change", function () {

                const form = this.closest("form");

                if (!form) {
                    return;
                }

                const startInput = form.querySelector(".auto-mandays-start");
                const dueInput = form.querySelector(".auto-mandays-due");
                const manDaysInput = form.querySelector(".auto-mandays-target");

                if (!startInput || !dueInput || !manDaysInput) {
                    return;
                }

                if (!startInput.value || !dueInput.value) {
                    return;
                }

                const start = new Date(startInput.value);
                const due = new Date(dueInput.value);
                const diffDays = Math.round((due - start) / (1000 * 60 * 60 * 24)) + 1;

                if (diffDays > 0) {
                    manDaysInput.value = diffDays;
                }

            });

        });

    </script>

}