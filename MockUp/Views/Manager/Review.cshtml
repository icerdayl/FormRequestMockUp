@model RequestForm.Models.Request

@{
    ViewData["Title"] = "Review Request";

    var canDecide = Model.Status?.StatusName == "Approved by Supervisor";
}

<div class="container-fluid">

    <div class="card shadow">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h3>Request Details</h3>

            <a asp-action="Index"
               class="btn btn-secondary">

                Back

            </a>

        </div>

        <div class="card-body">

            <div class="row mb-4">

                <div class="col-md-6">

                    <label class="fw-bold">
                        Request Title
                    </label>

                    <p>@Model.Title</p>

                </div>

                <div class="col-md-6">

                    <label class="fw-bold">
                        Ticket Type
                    </label>

                    <p>
                        @Model.TicketType?.TicketTypeName
                    </p>

                </div>

            </div>


            <div class="row mb-4">

                <div class="col-md-6">

                    <label class="fw-bold">
                        Department
                    </label>

                    <p>@Model.Department</p>

                </div>

                <div class="col-md-6">

                    <label class="fw-bold">
                        Priority
                    </label>

                    <p>@Model.Priority</p>

                </div>

            </div>


            <div class="mb-4">

                <label class="fw-bold">
                    Description
                </label>

                <p>@Model.Description</p>

            </div>


            <div class="row mb-4">

                <div class="col-md-6">

                    <label class="fw-bold">
                        Preferred Completion Date
                    </label>

                    <p>
                        @Model.PreferredCompletionDate.ToString("MMMM dd, yyyy")
                    </p>

                </div>

                <div class="col-md-6">

                    <label class="fw-bold">
                        Status
                    </label>

                    <p>
                        @Model.Status?.StatusName
                    </p>

                </div>

            </div>


            <div class="row mb-4">

                <div class="col-md-6">

                    <label class="fw-bold">
                        Supporting Document
                    </label>

                    <p>
                        @if (!string.IsNullOrWhiteSpace(Model.AttachmentPath))
                        {
                            <a href="@Model.AttachmentPath" target="_blank">
                                <i class="bi bi-paperclip"></i>
                                @System.IO.Path.GetFileName(Model.AttachmentPath)
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">No file attached</span>
                        }
                    </p>

                </div>

            </div>


            <partial name="_ApprovalRemarks" model="@(ViewBag.Remarks as RequestForm.Models.ViewModels.ApprovalRemarksViewModel)" />

            <hr />


            <div class="card mt-4">

                <div class="card-header">

                    <h5>Manager Decision</h5>

                </div>

                <div class="card-body">

                    @if (canDecide)
                    {
                        <button type="button"
                                class="btn btn-success btn-sm approval-btn"
                                data-id="@Model.RequestId"
                                data-action="Approved"
                                data-bs-toggle="modal"
                                data-bs-target="#reviewApprovalModal">

                            Approve

                        </button>

                        <button type="button"
                                class="btn btn-danger btn-sm approval-btn"
                                data-id="@Model.RequestId"
                                data-action="Rejected"
                                data-bs-toggle="modal"
                                data-bs-target="#reviewApprovalModal">

                            Reject

                        </button>
                    }
                    else
                    {
                        <p class="text-muted mb-0">

                            This is the final approval stage and a decision has
                            already been made. Current status:
                            <strong>@Model.Status?.StatusName</strong>

                        </p>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

@if (canDecide)
{
    <partial name="_ReviewApprovalModal" model="@("Manager")" />
}
