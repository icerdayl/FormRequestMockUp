@{
    ViewData["Title"] = "Approval Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/approval.css" />
}

<div class="container-fluid">

    <div class="card shadow">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h3>Approval Dashboard</h3>

            <span class="badge bg-primary fs-6">
                3 Pending Requests
            </span>

        </div>

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-4">

                    <input class="form-control" placeholder="Search request...">

                </div>

                <div class="col-md-3">

                    <select class="form-select">
                        <option>All Request Types</option>
                        <option>New Website</option>
                        <option>Enhancement</option>
                        <option>Maintenance</option>
                        <option>Bug Fix</option>
                    </select>

                </div>

                <div class="col-md-3">

                    <select class="form-select">
                        <option>All Priorities</option>
                        <option>High</option>
                        <option>Medium</option>
                        <option>Low</option>
                    </select>

                </div>

            </div>

            <table class="table table-hover align-middle">

                <thead>

                    <tr>

                        <th>ID</th>
                        <th>Title</th>
                        <th>Department</th>
                        <th>Request Type</th>
                        <th>Priority</th>
                        <th>Date Submitted</th>
                        <th>Status</th>
                        <th width="230">Action</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>WR-001</td>

                        <td>Company Website Redesign</td>

                        <td>Marketing</td>

                        <td>Enhancement</td>

                        <td>
                            <span class="badge bg-danger">
                                High
                            </span>
                        </td>

                        <td>July 30, 2026</td>

                        <td>
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        </td>

                        <td>

                            <a asp-controller="Request"
                               asp-action="Details"
                               class="btn btn-outline-primary btn-sm">

                                Review
                            </a>

                            <button class="btn btn-outline-success btn-sm">
                                Approve
                            </button>

                            <button class="btn btn-outline-danger btn-sm">
                                Reject
                            </button>

                        </td>

                    </tr>

                    <tr>

                        <td>WR-002</td>

                        <td>Payroll Portal</td>

                        <td>Finance</td>

                        <td>New Website</td>

                        <td>
                            <span class="badge bg-warning text-dark">
                                Medium
                            </span>
                        </td>

                        <td>July 28, 2026</td>

                        <td>
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        </td>

                        <td>

                            <a asp-controller="Request"
                               asp-action="Details"
                               class="btn btn-outline-primary btn-sm">

                                Review

                            </a>

                            <button class="btn btn-outline-success btn-sm">
                                Approve
                            </button>

                            <button class="btn btn-outline-danger btn-sm">
                                Reject
                            </button>
                        </td>

                    </tr>

                    <tr>

                        <td>WR-003</td>

                        <td>HR Management System</td>

                        <td>HR</td>

                        <td>Maintenance</td>

                        <td>
                            <span class="badge bg-secondary text-dark">
                                Low
                            </span>
                        </td>

                        <td>July 31, 2026</td>

                        <td>
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        </td>

                        <td>

                            <a asp-controller="Request"
                               asp-action="Details"
                               class="btn btn-outline-primary btn-sm">

                                Review

                            </a>

                            <button class="btn btn-outline-success btn-sm">
                                Approve
                            </button>

                            <button class="btn btn-outline-danger btn-sm">
                                Reject
                            </button>
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>