@model RequestForm.Models.Request

@{
    ViewData["Title"] = "Request Details";
}

@section Styles {
    <link rel="stylesheet" href="~/css/request-details.css" />
}

<div class="container-fluid">

    <div class="card shadow">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h3>Request Details</h3>

            <a asp-action="MyRequests"
               class="btn btn-secondary">

                Back

            </a>

        </div>

        <div class="card-body">

            <div class="row mb-4">

                <div class="col-md-6">

                    <label class="fw-bold">Request Title</label>

                    <p>@Model.Title</p>

                </div>

                <div class="col-md-6">

                    <label class="fw-bold">Request Type</label>

                    <p>@Model.RequestType?.RequestTypeName</p>

                </div>

            </div>

            <div class="row mb-4">

                <div class="col-md-6">

                    <label class="fw-bold">Department</label>

                    <p>@Model.Department</p>

                </div>

                <div class="col-md-6">

                    <label class="fw-bold">Priority</label>

                    <p>@Model.Priority</p>

                </div>

            </div>

            <div class="mb-4">

                <label class="fw-bold">Description</label>

                <p>@Model.Description</p>

            </div>

            <div class="row mb-4">

                <div class="col-md-6">

                    <label class="fw-bold">Start Date</label>

                    <p>
                        @(Model.StartDate.HasValue
                            ? Model.StartDate.Value.ToString("MMMM dd, yyyy")
                            : "Not set")
                    </p>

                </div>

                <div class="col-md-6">

                    <label class="fw-bold">Preferred Completion Date</label>

                    <p>@Model.PreferredCompletionDate.ToString("MMMM dd, yyyy")</p>

                </div>

            </div>

            <div class="row">

                <div class="col-md-6">

                    <label class="fw-bold">Status</label>

                    <p>@Model.Status?.StatusName</p>

                </div>

                <div class="col-md-6">

                    <label class="fw-bold">Supporting Document</label>

                    <p>
                        @if (!string.IsNullOrWhiteSpace(Model.AttachmentPath))
                        {
                            <a href="@Model.AttachmentPath" target="_blank">
                                <i class="bi bi-paperclip"></i>
                                @System.IO.Path.GetFileName(Model.AttachmentPath)
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">No file attached</span>
                        }
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>