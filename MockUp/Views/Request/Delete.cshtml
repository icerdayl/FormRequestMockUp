@model RequestForm.Models.Request

@{
    ViewData["Title"] = "Delete Request";
}

<div class="container">

    <div class="card shadow">

        <div class="card-header bg-danger text-white">

            <h3>Delete Request</h3>

        </div>

        <div class="card-body">

            <h5>

                Are you sure you want to delete this request?

            </h5>

            <hr>

            <dl class="row">

                <dt class="col-sm-3">
                    Reference Number
                </dt>

                <dd class="col-sm-9">
                    @Model.ReferenceNumber
                </dd>

                <dt class="col-sm-3">
                    Title
                </dt>

                <dd class="col-sm-9">
                    @Model.Title
                </dd>

                <dt class="col-sm-3">
                    Ticket Type
                </dt>

                <dd class="col-sm-9">
                    @Model.TicketType?.TicketTypeName
                </dd>

            </dl>

            <form asp-action="Delete">

                @Html.AntiForgeryToken()

                <input asp-for="RequestId" type="hidden" />

                <button class="btn btn-danger"
                        type="submit">

                    Delete

                </button>

                <a asp-action="MyRequests"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>