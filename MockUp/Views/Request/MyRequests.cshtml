@model IEnumerable<RequestForm.Models.Request>

@{
    ViewData["Title"] = "My Requests";
}

@section Styles {
    <link rel="stylesheet" href="~/css/myrequests.css" />
}

<div class="container-fluid">

    @if (TempData["FeaturesSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["FeaturesSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["FeaturesWarning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["FeaturesWarning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h3>My Requests</h3>

            <a href="/Request/Create" class="btn btn-primary">
                New Request
            </a>

        </div>

        <div class="card-body">

            <form method="get" class="row mb-3" id="filterForm">

                <div class="col-md-4">

                    <input class="form-control"
                           name="search"
                           value="@ViewBag.Search"
                           placeholder="Search request..." />

                </div>

                <div class="col-md-3">

                    <select class="form-select"
                            name="status">

                        <option value="All">All Status</option>

                        <option value="Pending">Pending</option>

                        <option value="Approved">Approved</option>

                        <option value="Rejected">Rejected</option>

                        <option value="In Progress">In Progress</option>

                        <option value="Completed">Completed</option>

                    </select>

                </div>

                <div class="col-md-2">

                    <a asp-action="MyRequests"
                       class="btn btn-secondary w-100">

                        Clear

                    </a>

                </div>

            </form>

            <table class="table table-hover align-middle">

                <thead>

                    <tr>

                        <th>Ref. #</th>
                        <th>Title</th>
                        <th>Ticket Type</th>
                        <th>Date Submitted</th>
                        <th>Status</th>
                        <th>Attachment</th>
                        <th width="220">Action</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.ReferenceNumber</td>

                                <td>@item.Title</td>

                                <td>@item.TicketType?.TicketTypeName</td>

                                <td>@item.DateSubmitted.ToString("MMM dd, yyyy")</td>

                                <td>
                                    @{
                                        var badge = item.Status?.StatusName switch
                                        {
                                            "Pending" => "bg-warning text-dark",
                                            "Approved by Help Desk" => "border border-2 border-primary text-black bg-primary-subtle",
                                            "Approved by Supervisor" => "border border-2 border-success text-black bg-success-subtle",
                                            "Approved by Manager" => "bg-success",
                                            "Rejected" => "bg-danger",
                                            "In Progress" => "bg-primary",
                                            "Completed" => "bg-secondary",
                                            _ => "bg-dark"
                                        };
                                    }

                                    <span class="badge @badge">
                                        @item.Status?.StatusName
                                    </span>
                                </td>

                                <td class="justify-content-center">
                                    @if (!string.IsNullOrWhiteSpace(item.AttachmentPath))   
                                    {
                                        <a href="@item.AttachmentPath"
                                           target="_blank"
                                           title="@System.IO.Path.GetFileName(item.AttachmentPath)">
                                            <div class="card border-1 border-primary link-primary">
                                                <i class="bi bi-paperclip">View File</i>
                                            </div>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">&mdash;</span>
                                    }
                                </td>

                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@item.RequestId"
                                       class="btn btn-sm btn-outline-primary">

                                        View

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.RequestId"
                                       class="btn btn-sm btn-outline-success">

                                        Edit

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.RequestId"
                                       class="btn btn-sm btn-outline-danger">

                                        Delete

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                No requests found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts{

    <script>

        let timer;

        const form =
            document.getElementById("filterForm");

        const search =
            document.querySelector("input[name='search']");

        search.addEventListener("keyup", function () {

            clearTimeout(timer);

            timer = setTimeout(function () {

                form.submit();

            }, 500);

        });

    </script>

}