@model IEnumerable<RequestForm.Models.Request>

@{
    ViewData["Title"] = "My Requests";
}

@section Styles {
    <link rel="stylesheet" href="~/css/myrequests.css" />
}

<div class="container-fluid">

    <div class="card shadow">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h3>My Requests</h3>

            <a href="/Request/Create" class="btn btn-primary">
                New Request
            </a>

        </div>

        <div class="card-body">

            <form method="get" class="row mb-3">

                <div class="col-md-4">

                    <input class="form-control"
                           name="search"
                           value="@ViewBag.Search"
                           placeholder="Search request..." />

                </div>

                <div class="col-md-3">

                    <select class="form-select"
                            name="status">

                        <option value="All">All Status</option>

                        <option value="Pending">Pending</option>

                        <option value="Approved">Approved</option>

                        <option value="Rejected">Rejected</option>

                        <option value="In Progress">In Progress</option>

                        <option value="Completed">Completed</option>

                    </select>

                </div>

                <div class="col-md-2">

                    <button class="btn btn-primary w-100">

                        Search

                    </button>

                </div>

                <div class="col-md-2">

                    <a asp-action="MyRequests"
                       class="btn btn-secondary w-100">

                        Clear

                    </a>

                </div>

            </form>

            <table class="table table-hover align-middle">

                <thead>

                    <tr>

                        <th>Ref. #</th>
                        <th>Title</th>
                        <th>Request Type</th>
                        <th>Date Submitted</th>
                        <th>Status</th>
                        <th width="220">Action</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.ReferenceNumber</td>

                                <td>@item.Title</td>

                                <td>@item.RequestType?.RequestTypeName</td>

                                <td>@item.DateSubmitted.ToString("MMM dd, yyyy")</td>

                                <td>
                                    @{
                                        var badge = item.Status?.StatusName switch
                                        {
                                            "Pending" => "bg-warning text-dark",
                                            "Approved" => "bg-success",
                                            "Rejected" => "bg-danger",
                                            "In Progress" => "bg-info",
                                            "Completed" => "bg-primary",
                                            _ => "bg-secondary"
                                        };
                                    }

                                    <span class="badge @badge">
                                        @item.Status?.StatusName
                                    </span>

                                </td>

                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@item.RequestId"
                                       class="btn btn-sm btn-outline-primary">

                                        View

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.RequestId"
                                       class="btn btn-sm btn-outline-success">

                                        Edit

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.RequestId"
                                       class="btn btn-sm btn-outline-danger">

                                        Delete

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No requests found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>