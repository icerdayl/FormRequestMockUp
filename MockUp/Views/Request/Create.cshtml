@model RequestForm.Models.Request

@{
    ViewData["Title"] = "Create Request";
}

@section Styles{

<link rel="stylesheet" href="~/css/request.css" />

}

<div class="container-fluid">

    <div class="card shadow">

        <div class="card-header">

            <h3>Change Request Form</h3>

        </div>

        <div class="card-body">

            <form asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="section-header">

                    <span class="section-number">
                        1
                    </span>

                    <h5>Request Information</h5>

                </div>

                <div class="row">

                    <div class="col-md-8 mb-3">

                        <label class="form-label">

                            Request Title

                            <span class="required">*</span>

                        </label>

                        <input asp-for="Title"
                               id="Title"
                               class="form-control shadow-sm" />

                        <small id="titleCounter" class="text-muted d-block mt-1">
                            0 / 15 words
                        </small>

                        <span id="titleError" class="text-danger"></span>

                        <span asp-validation-for="Title"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label class="form-label">

                            Request Type

                            <span class="required">*</span>

                        </label>

                        <select asp-for="RequestTypeId"
                                class="form-select">

                            <option value="">Select Request Type</option>

                            @foreach (var item in ViewBag.RequestTypes)
                            {
                                <option value="@item.RequestTypeId">
                                    @item.RequestTypeName
                                </option>
                            }

                        </select>

                        <span asp-validation-for="RequestTypeId"
                              class="text-danger"></span>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6">

                        <label class="form-label">

                            Department

                            <span class="required">*</span>

                        </label>

                        <input asp-for="Department"
                               class="form-control shadow-sm" />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">

                            Priority

                            <span class="required">*</span>

                        </label>

                        <select asp-for="Priority"
                                class="form-select">

                            <option>Low</option>

                            <option>Medium</option>

                            <option>High</option>

                        </select>

                    </div>

                </div>

                <hr>
                <div class="section-header">

                    <span class="section-number">
                        2
                    </span>

                    <h5>Project Details</h5>

                </div>

                <div class="mb-3">

                    <label class="form-label">

                        Project Description

                        <span class="required">*</span>

                    </label>

                    <textarea asp-for="Description"
                              id="Description"
                              class="form-control"
                              rows="5"></textarea>

                    <small id="descriptionCounter"
                           class="text-muted d-block mt-1">

                        0 / 50 words

                    </small>

                    <span id="descriptionError"
                          class="text-danger"></span>

                    <div class="form-text">
                        Describe the requested website, including its purpose and expected functionality.
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6">

                        <label class="form-label">
                            Start Date

                            <span class="required">*</span>
                        </label>

                        <input asp-for="StartDate"
                               id="StartDate"
                               type="date"
                               class="form-control shadow-sm"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />

                        <span asp-validation-for="StartDate"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Requested Completion Date

                            <span class="required">*</span>
                        </label>

                        <input asp-for="PreferredCompletionDate"
                               id="PreferredCompletionDate"
                               type="date"
                               class="form-control shadow-sm"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />

                        <span id="dateOrderError" class="text-danger"></span>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6">

                        <label class="form-label">

                            Supporting Documents
                        </label>

                        <div class="upload-box">

                            <i class="bi bi-cloud-arrow-up"></i>

                            <p>Drag & Drop Files Here</p>

                            <input type="file"
                                   id="Attachment"
                                   name="Attachment"
                                   class="form-control"
                                   accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg">

                        </div>

                    </div>

                </div>

                <div class="text-end mt-5">

                    <button type="button"
                            class="btn btn-secondary"
                            onclick="location.href='@Url.Action("MyRequests", "Request")'">

                        Cancel

                    </button>

                    <button type="button" class="btn btn-warning">
                        Save Draft
                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        Submit Request

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts{

    <script src="~/js/request-validation.js"></script>

}