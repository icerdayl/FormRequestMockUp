@{
    var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
    var action = ViewContext.RouteData.Values["Action"]?.ToString();
}

<div class="sidebar">

    <div class="logo">
        <i class="bi bi-window-stack"></i>
        <span>Request Form</span>
    </div>

    <ul class="menu">

        <li>
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="nav-link @(controller == "Dashboard" && action == "Index" ? "active" : "")">

                <i class="bi bi-speedometer2"></i>
                Dashboard

            </a>
        </li>

        <!-- REQUEST MENU -->

        <li>

            <a class="nav-link d-flex justify-content-between align-items-center @(controller == "Request" ? "active" : "")"
               data-bs-toggle="collapse"
               href="#requestMenu"
               role="button"
               aria-expanded="@(controller == "Request" ? "true" : "false")">

                <span>

                    <i class="bi bi-file-earmark-text"></i>

                    Request

                </span>

                <i class="bi bi-chevron-down"></i>

            </a>

            <div class="collapse @(controller == "Request" ? "show" : "")"
                 id="requestMenu">

                <ul class="nav flex-column ms-3">

                    <li>

                        <a asp-controller="Request"
                           asp-action="Create"
                           class="nav-link @(controller == "Request" && action == "Create" ? "active" : "")">

                            Create Request

                        </a>

                    </li>

                    <li>

                        <a asp-controller="Request"
                           asp-action="MyRequests"
                           class="nav-link @(controller == "Request" && action == "MyRequests" ? "active" : "")">

                            My Requests

                        </a>

                    </li>

                </ul>

            </div>

        </li>

        <li>

            <a asp-controller="Approval"
               asp-action="Index"
               class="nav-link @(controller == "Approval" ? "active" : "")">

                <i class="bi bi-check2-square"></i>

                Approvals

            </a>

        </li>

        <li>

            <a asp-controller="Assignment"
               asp-action="Index"
               class="nav-link @(controller == "Assignment" ? "active" : "")">

                <i class="bi bi-person-workspace"></i>

                Assignments

            </a>

        </li>

        <li>

            <a asp-controller="Developer"
               asp-action="Index"
               class="nav-link @(controller == "Developer" ? "active" : "")">

                <i class="bi bi-person-gear"></i>

                Developer

            </a>

        </li>

        <li>

            <a asp-controller="Admin"
               asp-action="Index"
               class="nav-link @(controller == "Admin" ? "active" : "")">

                <i class="bi bi-gear"></i>

                Administration

            </a>

        </li>

    </ul>

</div>