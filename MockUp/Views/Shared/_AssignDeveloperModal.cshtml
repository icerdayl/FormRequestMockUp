@using RequestForm.Models

<div class="modal fade"
     id="assignModal"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <form asp-controller="HelpDesk"
                  asp-action="AssignDeveloper"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h5 class="modal-title">

                        Assign Developer

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <input type="hidden"
                           id="RequestId"
                           name="RequestId" />

                    <label class="form-label">

                        Developer

                    </label>

                    <select class="form-select"
                            name="AssignedTo">

                        @foreach (var dev in FakeDevelopers.Developers)
                        {
                            <option value="@dev">

                                @dev

                            </option>
                        }

                    </select>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button class="btn btn-primary"
                            type="submit">

                        Assign

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>