@model List<RequestForm.Models.Feature>

@if (Model != null && Model.Any())
{
    <div class="mb-4">

        <label class="fw-bold d-block mb-2">Features & Subtasks</label>

        @foreach (var feature in Model)
        {
            var doneCount = feature.SubTasks.Count(s => s.Status == "Done");
            var totalCount = feature.SubTasks.Count;
            var percent = totalCount == 0 ? 0 : (int)Math.Round(100.0 * doneCount / totalCount);

            <div class="card mb-2">

                <div class="card-body py-2">

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                        <div>
                            <strong>@feature.Title</strong>
                            <span class="badge bg-secondary ms-1">@feature.Priority</span>
                        </div>

                        @if (totalCount > 0)
                        {
                            <small class="text-muted">@doneCount / @totalCount subtasks done (@percent%)</small>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(feature.Description))
                    {
                        <p class="text-muted small mb-2 mt-1">@feature.Description</p>
                    }

                    @if (totalCount > 0)
                    {
                        <ul class="list-unstyled mb-0 small mt-2">

                            @foreach (var subTask in feature.SubTasks.OrderBy(s => s.SortOrder))
                            {
                                var badgeClass = subTask.Status switch
                                {
                                    "Done" => "bg-success",
                                    "In Progress" => "bg-warning text-dark",
                                    _ => "bg-secondary"
                                };

                                <li class="mb-1">
                                    <span class="badge @badgeClass" style="width:90px;">@subTask.Status</span>
                                    <span class="@(subTask.Status == "Done" ? "text-decoration-line-through text-muted" : "")">
                                        @subTask.Title
                                    </span>
                                    <span class="text-muted">
                                        &middot; @(subTask.EstimatedManDays?.ToString("0.##") ?? "—") MD
                                    </span>
                                </li>
                            }

                        </ul>
                    }

                </div>

            </div>
        }

    </div>
}
