@model List<RequestForm.Models.Request>
@{
    ViewData["Title"] = "Developer Dashboard";
    var developers = ViewBag.Developers as List<string>;
    var selected = ViewBag.SelectedDeveloper as string;
}

<div class="container-fluid">

    <div class="card shadow">

        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">

            <h3 class="mb-0">My Assigned Requests</h3>

            <form method="get" class="d-flex align-items-center gap-2">

                <label class="form-label mb-0 small text-muted">Viewing as</label>

                <select name="developer" class="form-select form-select-sm" onchange="this.form.submit()" style="width:auto;">

                    @if (developers != null)
                    {
                        @foreach (var dev in developers)
                        {
                            <option value="@dev" selected="@(dev == selected)">@dev</option>
                        }
                    }

                </select>

            </form>

        </div>

        <div class="card-body">

            @if (Model.Any())
            {
                @foreach (var request in Model)
                {
                    var allSubTasks = request.Features.SelectMany(f => f.SubTasks).ToList();
                    var doneCount = allSubTasks.Count(s => s.Status == "Done");
                    var totalCount = allSubTasks.Count;
                    var percent = totalCount == 0 ? 0 : (int)Math.Round(100.0 * doneCount / totalCount);

                    <a asp-action="Details"
                       asp-route-id="@request.RequestId"
                       asp-route-developer="@selected"
                       class="text-decoration-none text-dark">

                        <div class="card mb-3 shadow-sm">

                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-start">

                                    <div class="flex-grow-1">

                                        <h5 class="mb-1">
                                            @request.ReferenceNumber &middot; @request.Title
                                        </h5>

                                        <span class="badge bg-secondary me-1">
                                            @request.TicketType?.TicketTypeName
                                        </span>

                                        <span class="badge bg-info text-dark me-1">
                                            @request.Priority Priority
                                        </span>

                                        <span class="badge bg-light text-dark border">
                                            @request.Status?.StatusName
                                        </span>

                                        <p class="text-muted small mt-2 mb-1">
                                            Due @request.PreferredCompletionDate.ToString("MMM dd, yyyy")
                                            &middot;
                                            @request.Features.Count feature(s), @totalCount subtask(s)
                                        </p>

                                        @if (totalCount > 0)
                                        {
                                            <div class="d-flex align-items-center gap-2" style="max-width: 350px;">

                                                <div class="progress flex-grow-1" style="height: 8px;">
                                                    <div class="progress-bar bg-success"
                                                         style="width: @(percent)%;"></div>
                                                </div>

                                                <small class="text-muted">
                                                    @doneCount / @totalCount (@percent%)
                                                </small>

                                            </div>
                                        }
                                        else
                                        {
                                            <p class="text-muted small mb-0">
                                                No subtasks yet for this request.
                                            </p>
                                        }

                                    </div>

                                    <i class="bi bi-chevron-right fs-4 text-muted"></i>

                                </div>

                            </div>

                        </div>

                    </a>
                }
            }
            else
            {
                <p class="text-muted text-center mb-0">
                    No requests currently assigned to @selected.
                </p>
            }

        </div>

    </div>

</div>
